# Optional. The demo briefs alerts without a key.
# Copy to .env (gitignored). Never commit a real key.
# A free key from https://openrouter.ai/keys is enough. The default model
# is openrouter/free, which picks a free model for each request.
OPENROUTER_API_KEY=
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=openrouter/free
